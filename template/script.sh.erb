#!/usr/bin/env bash

# Load the required environment
<% if context.environment_check == "custom" %>
<%= context.custom_environment.gsub(/\r\n?/, "\n") %>
<% else %>
module use /storage/icds/RISE/sw8/modules
module load anaconda
conda activate <%= context.prebuilt_environment %>
<% end %>

# Additional kernel support for Julia
export JULIA_NUM_THREADS=${SLURM_CPUS_ON_NODE}
echo "JULIA_NUM_THREADS: ${JULIA_NUM_THREADS}"

# Start Jupyter Notebook Server
echo "Host: ${host}"
echo "Port: ${port}"
echo "Password: ${password}"
echo "Jupyter Password: ${JUPYTER_PASSWORD}"

cd ${HOME}

JUPYTER_CMD="<%= context.jupyter_exec %>"

# Check Jupyter executable and list conda environments
echo "Jupyter Executable: ${JUPYTER_CMD}"
echo "Jupyter Path: $(which "${JUPYTER_CMD}")"
echo "Jupyter Version: $("${JUPYTER_CMD}" --version)"

conda env list

if ${JUPYTER_CMD} --help-all 2>/dev/null | grep -q "ServerApp.base_url"; then
    # Jupyter Server (1.x/2.x) and Notebook 7+ uses ServerApp.* config (2022-)
    APP=ServerApp
    ROOT_OPT="--ServerApp.root_dir=${HOME}"
else
    # Jupyter Notebook 5.x/6.x uses NotebookApp.* config (2017-2023)
    APP=NotebookApp
    ROOT_OPT="--notebook-dir=${HOME}"
fi

exec ${JUPYTER_CMD} \
    --no-browser \
    --ip="${ip}" \
    --port="${port}" \
    --${APP}.port_retries=0 \
    --${APP}.base_url="/node/${host}/${port}" \
    --${APP}.password="${JUPYTER_PASSWORD}" \
    --${APP}.disable_check_xsrf=True \
    --${APP}.allow_origin='*' \
    --NotebookNotary.db_file=':memory:'
    ${ROOT_OPT} \
